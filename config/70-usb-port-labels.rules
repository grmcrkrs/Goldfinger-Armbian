# Stable physical USB port labels for this enclosure.
# Whole-disk aliases: /dev/usb-port-B1, /dev/usb-port-W2, etc.
# Partition aliases add -partN.

SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNELS=="2-1", ENV{ID_PHYSICAL_PORT}="B1", SYMLINK+="usb-port-B1"
SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNELS=="2-1", ENV{ID_PHYSICAL_PORT}="B1", SYMLINK+="usb-port-B1-part%n"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNELS=="1-1.3", ENV{ID_PHYSICAL_PORT}="W2", SYMLINK+="usb-port-W2"
SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNELS=="1-1.3", ENV{ID_PHYSICAL_PORT}="W2", SYMLINK+="usb-port-W2-part%n"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNELS=="1-1.1", ENV{ID_PHYSICAL_PORT}="W3", SYMLINK+="usb-port-W3"
SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNELS=="1-1.1", ENV{ID_PHYSICAL_PORT}="W3", SYMLINK+="usb-port-W3-part%n"
SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNELS=="1-2", ENV{ID_PHYSICAL_PORT}="W4", SYMLINK+="usb-port-W4"
SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", KERNELS=="1-2", ENV{ID_PHYSICAL_PORT}="W4", SYMLINK+="usb-port-W4-part%n"

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="2-1", ENV{ID_PHYSICAL_PORT}="B1"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="1-1.3", ENV{ID_PHYSICAL_PORT}="W2"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="1-1.1", ENV{ID_PHYSICAL_PORT}="W3"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="1-2", ENV{ID_PHYSICAL_PORT}="W4"
